{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "memoria",
  "version": "0.0.0",
  "identifier": "fr.noahboos.memoria",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Memoria",
        "url": "/",
        "width": 800,
        "height": 600
      },
      {
        "label": "settings",
        "title": "Settings",
        "url": "/settings",
        "width": 800,
        "height": 600,
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self'",
        "connect-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
